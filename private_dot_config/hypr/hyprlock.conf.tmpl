# Hyprlock configuration — Berg style
# Reference: https://wiki.hyprland.org/Hypr-Ecosystem/hyprlock

$font = Avenir Next M for BBG Medium
$card = rgba(0,0,0,0.65)
$on_surface = rgb(d7d7d7)
$primary = rgb(f49f31)
$warning = rgb(FEE334)
$error = rgb(d54135)
$shadow = rgba(0,0,0,0.85)

general {
    hide_cursor = false
}

auth {
    fingerprint {
        # Fingerprint auth is opt-in for hosts with a verified reader and enrollment.
        enabled = {{ eq .chezmoi.hostname "zygalski" }}
        ready_message = Touch sensor to unlock
        present_message = Scanning…
        retry_delay = 250
    }
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = /var/lib/arts-wallpaper/current.webp
    blur_passes = 0
}

# Top-right clock and date card (24px inner padding)
shape {
    monitor =
    size = 544, 176
    color = $card
    rounding = 15

    position = -24, -24
    halign = right
    valign = top
    zindex = 0
}

# Bottom-left artwork details card (mirrored 544px column, 24px inner padding)
shape {
    monitor =
    size = 544, 117
    color = $card
    rounding = 15

    position = 24, 24
    halign = left
    valign = bottom
    zindex = 0
}

# Keyboard layout chip below the password field
shape {
    monitor =
    size = 78, 42
    color = $card
    rounding = 12

    position = 0, -106
    halign = center
    valign = center
    zindex = 0
}

input-field {
    monitor =
    size = 20%, 5%
    outline_thickness = 3
    inner_color = $card

    outer_color = $primary   # active — Berg orange
    check_color = $primary   # waiting for authentication
    fail_color = $error      # authentication failure
    capslock_color = $warning

    font_color = $on_surface
    fade_on_empty = false
    rounding = 15
    shadow_passes = 2
    shadow_size = 3
    shadow_color = $shadow

    font_family = $font
    placeholder_text = Enter password…
    check_text = Authenticating…
    fail_text = Authentication failed ($ATTEMPTS)

    dots_spacing = 0.3

    position = 0, -20
    halign = center
    valign = center
    zindex = 1
}

# TIME + DATE (top-right, shared 15px optical line gap)
label {
    monitor =
    text = cmd[update:1000] date +"<span size='78pt' line_height='87040'>%H:%M</span>%n<span size='24pt'>%A, %d %B %Y</span>"
    text_align = right
    font_size = 24
    font_family = $font
    color = $on_surface
    shadow_passes = 2
    shadow_size = 3
    shadow_color = $shadow

    position = -48, -48
    halign = right
    valign = top
    zindex = 1
}

# CURRENT ARTWORK (bottom-left)
label {
    monitor =
    text = cmd[update:60000] /home/vitorpy/.config/hypr/hyprlock-artwork.sh
    text_align = left
    font_size = 20
    font_family = $font
    color = $on_surface
    shadow_passes = 2
    shadow_size = 3
    shadow_color = $shadow

    position = 48, 48
    halign = left
    valign = bottom
    zindex = 1
}

# Keyboard layout toggle (below password field)
label {
    monitor =
    text = $LAYOUT[EN,PL]
    font_size = 18
    font_family = $font
    color = $on_surface
    shadow_passes = 2
    shadow_size = 3
    shadow_color = $shadow
    onclick = hyprctl switchxkblayout all next

    position = 0, -106
    halign = center
    valign = center
    zindex = 1
}
