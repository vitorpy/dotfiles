# rclone owns its OAuth token in the live config after initial authorization.
# Run `rclone config reconnect gdrive:` on a new machine before starting the mount.
[gdrive]
type = drive
client_id = {{ (bitwardenFields "item" "rclone gdrive").client_id.value }}
client_secret = {{ (bitwardenFields "item" "rclone gdrive").client_secret.value }}
scope = drive.file
root_folder_id = 15JmTWrvx_iwJcEen_rrUXUkDO4wSib28

[box]
type = box
token = {{ (bitwardenFields "item" "rclone box").token.value }}
