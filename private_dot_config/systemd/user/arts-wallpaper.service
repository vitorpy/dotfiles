[Unit]
Description=Fetch an open-access artwork wallpaper
Wants=network-online.target
After=network-online.target
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
Environment=ARTS_WALLPAPER_DATA_DIR=/var/lib/arts-wallpaper
ExecStart=%h/.local/bin/arts-wallpaper rotate
TimeoutStartSec=5min
UMask=0027
