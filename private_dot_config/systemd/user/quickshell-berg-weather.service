[Unit]
Description=Refresh Quickshell Berg weather cache
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.config/quickshell/berg/scripts/update-clock-weather.sh
ExecStartPost=-/usr/bin/qs -c berg ipc call shell refreshClock
TimeoutStartSec=45s
UMask=0077
