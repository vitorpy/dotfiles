{
  "layer": "top",
  "spacing": 0,
  "modules-left": [
    "custom/dnf-updates",
    "custom/reboot-required"
  ],
  "modules-center": [
    "custom/clock"
  ],
  "modules-right": [
    "pulseaudio",
    "pulseaudio#mic",
    "custom/brightness",
    "power-profiles-daemon",
    "battery",
    "cpu",
    "temperature",
    "custom/kblayout",
    "tray",
    "custom/mako",
    "custom/power"
  ],
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "􀊣 off",
    "format-icons": { "default": ["􀊥", "􀊧"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "/home/vitorpy/.config/quickshell/berg/scripts/hyprpwcenter-toggle.sh",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "scroll-step": 5
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "􀊱 {volume}%",
    "format-source-muted": "􀊳 off",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "/home/vitorpy/.config/quickshell/berg/scripts/hyprpwcenter-toggle.sh",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "scroll-step": 5
  },
  "custom/brightness": {
    "exec": "~/.config/waybar/scripts/brightness.sh",
    "interval": 2,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "scroll-step": 5,
    "on-click": "brightnessctl set 100%",
    "format": "{}"
  },
  "power-profiles-daemon": { "format": "{profile}" },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-icons": ["􀛪", "􀛩", "􀺶", "􀺸", "􀛨"],
    "format-charging": "{capacity}% 􀢋",
    "states": {
      "critical": 5,
      "warning": 10
    }
  },
  "cpu": { "format": "􀧓 {usage}%"},
  "temperature": { "format": "􀇬 {temperatureC} °C" },
  "custom/clock": {
    "exec": "~/.config/quickshell/berg/scripts/smart-clock.sh",
    "interval": 30,
    "format": "{text}",
    "return-type": "json",
    "escape": true
  },
  "custom/kblayout": {
    "exec": "~/.config/quickshell/berg/scripts/kblayout.sh",
    "interval": 1,
    "on-click": "/home/vitorpy/.config/quickshell/berg/scripts/kbtoggle.sh"
  },
  "tray": { "spacing": 8 },
  "custom/power": {
    "format": "􀆨",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "~/.config/hypr/session-exit.sh poweroff",
      "reboot": "~/.config/hypr/session-exit.sh reboot",
      "logout": "~/.config/hypr/session-exit.sh logout"
    }
  },
  "custom/mako": {
    "exec": "/home/vitorpy/.config/quickshell/berg/scripts/dnd-status.sh",
    "on-click": "/home/vitorpy/.config/quickshell/berg/scripts/dnd-toggle.sh",
    "on-click-right": "/usr/bin/makoctl dismiss -a",
    "interval": 2,
    "return-type": "json"
  },
  "custom/dnf-updates": {
    "exec": "~/.config/quickshell/berg/scripts/pacman-updates.sh",
    "interval": 300,
    "return-type": "json"
  },
  "custom/reboot-required": {
    "exec": "~/.config/quickshell/berg/scripts/reboot-required.sh",
    "interval": 300,
    "return-type": "json"
  }
}
