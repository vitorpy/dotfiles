#!/usr/bin/env python3
"""Inspect or rotate the current artwork wallpaper."""

from __future__ import annotations

import argparse
import copy
import dataclasses
import datetime as dt
import fcntl
import html
import json
import os
import random
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable, Iterable, Mapping, Sequence
from pathlib import Path
from typing import Any, Protocol, TypeVar

VERSION = "1.4.1"
TARGET_WIDTH = 2560
HTTP_TIMEOUT_SECONDS = 20
MAX_DOWNLOAD_BYTES = 80 * 1024 * 1024
PROVIDER_NAMES = ("google", "rijksmuseum", "cleveland", "masp", "mnw")
FLAT_ART_TERMS = (
    "painting",
    "drawing",
    "print",
    "photograph",
    "pintura",
    "desenho",
    "gravura",
    "fotografia",
)
MNW_FLAT_ART_TERMS = (
    "obraz",
    "malarstwo",
    "rysunek",
    "grafika",
    "rycina",
    "fotografia",
)
MASP_MIN_LONG_EDGE = 2560
MASP_MIN_SHORT_EDGE = 1440
USER_AGENT = f"arts-wallpaper/{VERSION} (personal desktop wallpaper service)"


class WallpaperError(RuntimeError):
    """Base error for a failed wallpaper update."""


class ProviderError(WallpaperError):
    """A provider could not return a usable artwork."""


class AllProvidersError(WallpaperError):
    def __init__(self, errors: Mapping[str, str]):
        self.errors = dict(errors)
        details = "; ".join(f"{name}: {message}" for name, message in errors.items())
        super().__init__(f"all providers failed ({details})")


class HTTPClientProtocol(Protocol):
    def get_json(
        self,
        url: str,
        params: Mapping[str, Any] | Sequence[tuple[str, Any]] | None = None,
    ) -> Any: ...

    def download(self, url: str, destination: Path) -> str | None: ...


def clean_text(value: Any) -> str | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return str(value)
    if not isinstance(value, str):
        return None
    text = re.sub(r"<[^>]+>", " ", html.unescape(value))
    text = " ".join(text.split())
    return text or None


def iter_text(value: Any) -> Iterable[str]:
    if isinstance(value, str):
        cleaned = clean_text(value)
        if cleaned:
            yield cleaned
    elif isinstance(value, Mapping):
        for key in (
            "title",
            "name",
            "label",
            "_label",
            "description",
            "content",
            "@value",
        ):
            cleaned = clean_text(value.get(key))
            if cleaned:
                yield cleaned
        for nested in value.values():
            if isinstance(nested, (Mapping, list, tuple)):
                yield from iter_text(nested)
    elif isinstance(value, (list, tuple)):
        for nested in value:
            yield from iter_text(nested)


def is_flat_art(*values: Any) -> bool:
    text = " ".join(iter_text(values)).casefold()
    return any(term in text for term in FLAT_ART_TERMS)


def append_query(
    url: str,
    params: Mapping[str, Any] | Sequence[tuple[str, Any]] | None,
) -> str:
    if not params:
        return url
    parts = urllib.parse.urlsplit(url)
    existing = urllib.parse.parse_qsl(parts.query, keep_blank_values=True)
    items = list(params.items()) if isinstance(params, Mapping) else list(params)
    query = urllib.parse.urlencode(existing + items, doseq=True)
    return urllib.parse.urlunsplit(
        (parts.scheme, parts.netloc, parts.path, query, parts.fragment)
    )


class HTTPClient:
    def __init__(self, timeout: int = HTTP_TIMEOUT_SECONDS, attempts: int = 2):
        self.timeout = timeout
        self.attempts = attempts

    def _open(self, request: urllib.request.Request):
        last_error: Exception | None = None
        for attempt in range(self.attempts):
            try:
                return urllib.request.urlopen(request, timeout=self.timeout)
            except (
                urllib.error.HTTPError,
                urllib.error.URLError,
                TimeoutError,
                OSError,
            ) as exc:
                last_error = exc
                if attempt + 1 < self.attempts:
                    time.sleep(attempt + 1)
        raise ProviderError(f"request failed for {request.full_url}: {last_error}")

    def get_json(
        self,
        url: str,
        params: Mapping[str, Any] | Sequence[tuple[str, Any]] | None = None,
    ) -> Any:
        request_url = append_query(url, params)
        request = urllib.request.Request(
            request_url,
            headers={
                "Accept": "application/json, application/ld+json",
                "User-Agent": USER_AGENT,
            },
        )
        try:
            with self._open(request) as response:
                body = response.read(MAX_DOWNLOAD_BYTES + 1)
        except ProviderError:
            raise
        except Exception as exc:
            raise ProviderError(
                f"could not read JSON from {request_url}: {exc}"
            ) from exc
        if len(body) > MAX_DOWNLOAD_BYTES:
            raise ProviderError(f"JSON response from {request_url} exceeded size limit")
        try:
            return json.loads(body)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ProviderError(f"invalid JSON from {request_url}: {exc}") from exc

    def download(self, url: str, destination: Path) -> str | None:
        request = urllib.request.Request(
            url,
            headers={
                "Accept": "image/avif,image/webp,image/png,image/jpeg,image/*",
                "User-Agent": USER_AGENT,
            },
        )
        try:
            with self._open(request) as response, destination.open("wb") as output:
                content_type = response.headers.get_content_type()
                downloaded = 0
                while chunk := response.read(1024 * 1024):
                    downloaded += len(chunk)
                    if downloaded > MAX_DOWNLOAD_BYTES:
                        raise ProviderError(f"image from {url} exceeded size limit")
                    output.write(chunk)
        except ProviderError:
            raise
        except Exception as exc:
            raise ProviderError(f"could not download image from {url}: {exc}") from exc
        if downloaded == 0:
            raise ProviderError(f"empty image response from {url}")
        if content_type and not (
            content_type.startswith("image/")
            or content_type == "application/octet-stream"
        ):
            raise ProviderError(
                f"unexpected image content type {content_type!r} from {url}"
            )
        return content_type


@dataclasses.dataclass(frozen=True)
class Artwork:
    provider: str
    provider_name: str
    record_id: str
    title: str
    creator: str | None
    date: str | None
    attribution: str
    rights: str | None
    rights_url: str | None
    source_url: str
    image_url: str

    def metadata(self, width: int, height: int) -> dict[str, Any]:
        return {
            "provider": self.provider,
            "provider_name": self.provider_name,
            "record_id": self.record_id,
            "title": self.title,
            "creator": self.creator,
            "date": self.date,
            "attribution": self.attribution,
            "rights": self.rights,
            "rights_url": self.rights_url,
            "source_url": self.source_url,
            "image_url": self.image_url,
            "downloaded": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            "width": width,
            "height": height,
        }


@dataclasses.dataclass(frozen=True)
class Candidate:
    artwork: Artwork
    state_update: dict[str, Any] = dataclasses.field(default_factory=dict)


class GoogleProvider:
    name = "google"
    endpoint = "https://www.gstatic.com/culturalinstitute/tabext/imax_2_2.json"

    def __init__(self, http: HTTPClientProtocol, rng: random.Random):
        self.http = http
        self.rng = rng

    def select(self, state: Mapping[str, Any]) -> Candidate:
        del state
        records = self.http.get_json(self.endpoint)
        if not isinstance(records, list) or not records:
            raise ProviderError("Google Arts returned no artwork records")
        records = list(records)
        self.rng.shuffle(records)
        for record in records[:25]:
            if not isinstance(record, Mapping):
                continue
            image_base = clean_text(record.get("image"))
            link = clean_text(record.get("link"))
            title = clean_text(record.get("title"))
            if not image_base or not link or not title:
                continue
            source_url = urllib.parse.urljoin(
                "https://artsandculture.google.com/", link
            )
            return Candidate(
                Artwork(
                    provider=self.name,
                    provider_name="Google Arts & Culture",
                    record_id=link.rstrip("/").split("/")[-1],
                    title=title,
                    creator=clean_text(record.get("creator")),
                    date=None,
                    attribution=clean_text(record.get("attribution"))
                    or "Google Arts & Culture",
                    rights=None,
                    rights_url=None,
                    source_url=source_url,
                    image_url=f"{image_base}=s{TARGET_WIDTH}-rw",
                )
            )
        raise ProviderError("Google Arts returned no usable artwork record")


class ClevelandProvider:
    name = "cleveland"
    endpoint = "https://openaccess-api.clevelandart.org/api/artworks"

    def __init__(self, http: HTTPClientProtocol, rng: random.Random):
        self.http = http
        self.rng = rng

    @staticmethod
    def _params(skip: int) -> list[tuple[str, Any]]:
        return [("cc0", ""), ("has_image", 1), ("limit", 1), ("skip", skip)]

    def select(self, state: Mapping[str, Any]) -> Candidate:
        del state
        overview = self.http.get_json(self.endpoint, self._params(skip=0))
        try:
            total = int(overview["info"]["total"])
        except (KeyError, TypeError, ValueError) as exc:
            raise ProviderError(
                "Cleveland response did not include a result total"
            ) from exc
        if total < 1:
            raise ProviderError("Cleveland returned no CC0 artworks with images")

        for _ in range(16):
            response = self.http.get_json(
                self.endpoint, self._params(skip=self.rng.randrange(total))
            )
            records = response.get("data") if isinstance(response, Mapping) else None
            if (
                not isinstance(records, list)
                or not records
                or not isinstance(records[0], Mapping)
            ):
                continue
            record = records[0]
            if clean_text(record.get("share_license_status")) != "CC0":
                continue
            if not is_flat_art(record.get("type"), record.get("classification")):
                continue
            images = record.get("images")
            image_url = None
            if isinstance(images, Mapping):
                for rendition in ("print", "web"):
                    image = images.get(rendition)
                    if isinstance(image, Mapping):
                        image_url = clean_text(image.get("url"))
                    if image_url:
                        break
            title = clean_text(record.get("title"))
            if not image_url or not title:
                continue
            creators = record.get("creators")
            creator_names: list[str] = []
            if isinstance(creators, list):
                for creator in creators:
                    if isinstance(creator, Mapping):
                        description = clean_text(creator.get("description"))
                        if description:
                            creator_names.append(description)
            record_id = clean_text(record.get("accession_number")) or str(
                record.get("id")
            )
            return Candidate(
                Artwork(
                    provider=self.name,
                    provider_name="Cleveland Museum of Art",
                    record_id=record_id,
                    title=title,
                    creator="; ".join(creator_names) or None,
                    date=clean_text(record.get("creation_date")),
                    attribution="Cleveland Museum of Art",
                    rights="CC0 1.0",
                    rights_url="https://creativecommons.org/publicdomain/zero/1.0/",
                    source_url=clean_text(record.get("url"))
                    or f"https://www.clevelandart.org/art/{urllib.parse.quote(record_id)}",
                    image_url=image_url,
                )
            )
        raise ProviderError("Cleveland did not return a usable flat CC0 artwork")


class MnwProvider:
    name = "mnw"
    provider_name = "Muzeum Narodowe w Warszawie (MNW)"
    search_endpoint = "https://cyfrowe-api.mnw.art.pl/api/search/Object/page/{page}"
    detail_endpoint = "https://cyfrowe-api.mnw.art.pl/api/object/{record_id}"
    source_base = "https://cyfrowe.mnw.art.pl/pl/katalog/"
    image_base = "https://cyfrowe-cdn.mnw.art.pl/upload/multimedia/"
    object_type_ids = (116727, 116729, 116786, 116704)
    public_domain_id = 500
    max_per_page = 80
    max_detail_attempts = 20

    def __init__(self, http: HTTPClientProtocol, rng: random.Random):
        self.http = http
        self.rng = rng

    @classmethod
    def _search_params(cls) -> list[tuple[str, Any]]:
        params: list[tuple[str, Any]] = [("maxPerPage", cls.max_per_page)]
        params.extend(("filter[types][]", type_id) for type_id in cls.object_type_ids)
        params.extend(
            (
                ("filter[copyrights][]", cls.public_domain_id),
                ("filter[formFeature][]", 3),
            )
        )
        return params

    @staticmethod
    def _record_id(value: Any) -> int | None:
        if isinstance(value, bool):
            return None
        try:
            record_id = int(value)
        except (TypeError, ValueError):
            return None
        return record_id if record_id > 0 else None

    @classmethod
    def _page(cls, response: Any) -> tuple[list[Mapping[str, Any]], int]:
        data = response.get("data") if isinstance(response, Mapping) else None
        if not isinstance(data, Mapping):
            raise ProviderError("MNW response did not include a data object")
        items = data.get("items")
        paginator = data.get("paginatorDetails")
        if not isinstance(items, list) or not isinstance(paginator, Mapping):
            raise ProviderError("MNW response did not include artwork pagination")
        try:
            total_pages = int(paginator["totalPagesCount"])
        except (KeyError, TypeError, ValueError) as exc:
            raise ProviderError("MNW response did not include a page total") from exc
        if total_pages < 1:
            raise ProviderError("MNW returned no matching artworks")
        records = [item for item in items if isinstance(item, Mapping)]
        if not records:
            raise ProviderError("MNW returned no artwork records on the selected page")
        return records, total_pages

    @staticmethod
    def _joined_names(value: Any) -> str | None:
        if not isinstance(value, list):
            return None
        names: list[str] = []
        for entry in value:
            if not isinstance(entry, Mapping):
                continue
            name = clean_text(entry.get("name"))
            if name and name not in names:
                names.append(name)
        return "; ".join(names) or None

    @classmethod
    def _is_flat_art(cls, record: Mapping[str, Any]) -> bool:
        values: list[Any] = []
        for field in ("types", "techniques"):
            entries = record.get(field)
            if not isinstance(entries, list):
                continue
            for entry in entries:
                if not isinstance(entry, Mapping):
                    continue
                values.extend(
                    entry.get(key)
                    for key in ("name", "title", "hierarchy", "hierarchyName")
                )
        text = " ".join(iter_text(values)).casefold()
        return any(term in text for term in MNW_FLAT_ART_TERMS)

    @classmethod
    def _public_domain_rights(
        cls, record: Mapping[str, Any]
    ) -> Mapping[str, Any] | None:
        rights = record.get("copyrights")
        if (
            not isinstance(rights, list)
            or len(rights) != 1
            or not isinstance(rights[0], Mapping)
        ):
            return None
        right = rights[0]
        if (
            cls._record_id(right.get("id")) != cls.public_domain_id
            or clean_text(right.get("name")) != "DOMENA PUBLICZNA"
            or right.get("restricted") is not False
        ):
            return None
        return right

    @staticmethod
    def _https_url(value: Any) -> str | None:
        url = clean_text(value)
        if not url:
            return None
        parts = urllib.parse.urlsplit(url)
        try:
            hostname = parts.hostname
            _ = parts.port
        except ValueError:
            return None
        if (
            parts.scheme != "https"
            or not hostname
            or parts.username is not None
            or parts.password is not None
        ):
            return None
        return urllib.parse.urlunsplit(
            ("https", parts.netloc, parts.path, parts.query, "")
        )

    @classmethod
    def _image_url(cls, record: Mapping[str, Any]) -> str | None:
        image = record.get("image")
        if not isinstance(image, Mapping):
            return None
        file_path = clean_text(image.get("filePath"))
        extension = clean_text(image.get("extension"))
        if (
            not file_path
            or not extension
            or not re.fullmatch(r"[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*", file_path)
            or not re.fullmatch(r"[A-Za-z0-9]{2,5}", extension)
        ):
            return None
        quoted_path = urllib.parse.quote(file_path, safe="/_-")
        quoted_extension = urllib.parse.quote(extension, safe="")
        return f"{cls.image_base}{quoted_path}.{quoted_extension}"

    @classmethod
    def _candidate(
        cls, record: Mapping[str, Any], expected_id: int
    ) -> Candidate | None:
        if cls._record_id(record.get("id")) != expected_id:
            return None
        title = clean_text(record.get("title"))
        rights = cls._public_domain_rights(record)
        image_url = cls._image_url(record)
        if not title or not rights or not image_url or not cls._is_flat_art(record):
            return None
        return Candidate(
            Artwork(
                provider=cls.name,
                provider_name=cls.provider_name,
                record_id=str(expected_id),
                title=title,
                creator=cls._joined_names(record.get("authors")),
                date=cls._joined_names(record.get("createDates")),
                attribution=cls.provider_name,
                rights="DOMENA PUBLICZNA",
                rights_url=cls._https_url(rights.get("link")),
                source_url=f"{cls.source_base}{expected_id}",
                image_url=image_url,
            )
        )

    def select(self, state: Mapping[str, Any]) -> Candidate:
        del state
        params = self._search_params()
        overview, total_pages = self._page(
            self.http.get_json(self.search_endpoint.format(page=1), params)
        )
        page = self.rng.randrange(1, total_pages + 1)
        records = overview
        if page != 1:
            records, _ = self._page(
                self.http.get_json(self.search_endpoint.format(page=page), params)
            )
        self.rng.shuffle(records)

        attempts = 0
        errors: list[str] = []
        for summary in records:
            record_id = self._record_id(summary.get("id"))
            if record_id is None:
                continue
            if attempts >= self.max_detail_attempts:
                break
            attempts += 1
            try:
                response = self.http.get_json(
                    self.detail_endpoint.format(record_id=record_id)
                )
            except ProviderError as exc:
                errors.append(str(exc))
                continue
            record = response.get("data") if isinstance(response, Mapping) else None
            if not isinstance(record, Mapping):
                continue
            candidate = self._candidate(record, record_id)
            if candidate:
                return candidate

        detail = f": {errors[-1]}" if errors else ""
        raise ProviderError(
            f"MNW returned no usable flat public-domain artwork after "
            f"{attempts} detail checks{detail}"
        )


class MaspProvider:
    name = "masp"
    page_base = "https://masp.org.br/pt/acervo/previous"
    asset_base = "https://assets.masp.org.br/"
    image_policy_url = "https://masp.org.br/acervo/intercambio"
    years = (
        2023,
        2022,
        2021,
        2020,
        2019,
        2018,
        2017,
        2016,
        2015,
        2012,
        2010,
        2009,
        2008,
        2007,
        2006,
        2005,
        2004,
        2003,
        2002,
        2001,
        1999,
        1998,
        1997,
        1996,
        1995,
        1994,
        1993,
        1992,
        1991,
        1990,
        1986,
        1966,
        1958,
        1953,
        1950,
        1947,
    )
    max_page_attempts = 3

    def __init__(self, http: HTTPClientProtocol, rng: random.Random):
        self.http = http
        self.rng = rng

    @classmethod
    def _page_url(cls, year: int, page: int = 1) -> str:
        return append_query(f"{cls.page_base}/{year}", {"page": page})

    @classmethod
    def _valid_page_url(cls, value: Any) -> str | None:
        url = clean_text(value)
        if not url:
            return None
        parts = urllib.parse.urlsplit(url)
        if parts.scheme != "https" or parts.hostname != "masp.org.br":
            return None
        if not re.fullmatch(r"/pt/acervo/previous/\d{4}", parts.path):
            return None
        query = urllib.parse.parse_qs(parts.query)
        if set(query) != {"page"}:
            return None
        page_values = query.get("page")
        if len(page_values or []) != 1:
            return None
        try:
            page = int(page_values[0])
            if page < 1:
                return None
        except (TypeError, ValueError):
            return None
        return urllib.parse.urlunsplit(
            (
                "https",
                "masp.org.br",
                parts.path,
                urllib.parse.urlencode({"page": page}),
                "",
            )
        )

    @classmethod
    def _image_url(cls, value: Any) -> str | None:
        path = clean_text(value)
        if not path:
            return None
        url = urllib.parse.urljoin(cls.asset_base, path)
        parts = urllib.parse.urlsplit(url)
        if (
            parts.scheme != "https"
            or parts.hostname != "assets.masp.org.br"
            or not parts.path.startswith("/uploads/")
        ):
            return None
        return urllib.parse.urlunsplit(
            ("https", "assets.masp.org.br", parts.path, parts.query, "")
        )

    def _initial_url(self) -> str:
        return self._page_url(self.rng.choice(self.years))

    def _state_url(self, state: Mapping[str, Any]) -> str:
        provider_state = state.get(self.name)
        if isinstance(provider_state, Mapping):
            saved = self._valid_page_url(provider_state.get("next"))
            if saved:
                return saved
        return self._initial_url()

    def _next_url(self, result: Mapping[str, Any]) -> str:
        return self._valid_page_url(result.get("next_page_url")) or self._initial_url()

    def _candidate(self, record: Mapping[str, Any], next_url: str) -> Candidate | None:
        if not is_flat_art(record.get("designation"), record.get("technique")):
            return None
        slug = clean_text(record.get("slug"))
        title = clean_text(record.get("title"))
        if not slug or not title:
            return None

        images = record.get("image")
        image_urls: list[str] = []
        if isinstance(images, list):
            for image in images:
                if not isinstance(image, Mapping):
                    continue
                image_url = self._image_url(image.get("path") or image.get("url"))
                if image_url and image_url not in image_urls:
                    image_urls.append(image_url)
        if not image_urls:
            return None
        self.rng.shuffle(image_urls)

        photo_credit = clean_text(record.get("photo_credits"))
        attribution = "Museu de Arte de São Paulo Assis Chateaubriand (MASP)"
        if photo_credit:
            attribution = f"{attribution}; photograph: {photo_credit}"
        return Candidate(
            Artwork(
                provider=self.name,
                provider_name="Museu de Arte de São Paulo Assis Chateaubriand (MASP)",
                record_id=slug,
                title=title,
                creator=clean_text(record.get("author")),
                date=clean_text(record.get("date_work")),
                attribution=attribution,
                rights="Personal, non-distributed use; MASP image-use terms apply",
                rights_url=self.image_policy_url,
                source_url=(
                    "https://masp.org.br/acervo/obra/"
                    f"{urllib.parse.quote(slug, safe='-')}"
                ),
                image_url=image_urls[0],
            ),
            {self.name: {"next": next_url}},
        )

    def select(self, state: Mapping[str, Any]) -> Candidate:
        page_url = self._state_url(state)
        for _ in range(self.max_page_attempts):
            response = self.http.get_json(page_url)
            result = response.get("result") if isinstance(response, Mapping) else None
            if not isinstance(result, Mapping):
                raise ProviderError("MASP response did not include a result object")
            items = result.get("items")
            if not isinstance(items, list):
                raise ProviderError("MASP response did not include artwork records")
            next_url = self._next_url(result)
            records = [item for item in items if isinstance(item, Mapping)]
            self.rng.shuffle(records)
            for record in records:
                candidate = self._candidate(record, next_url)
                if candidate:
                    return candidate
            page_url = next_url
        raise ProviderError("MASP returned no usable flat artwork after three pages")


def rijks_data_url(identifier: str) -> str:
    parts = urllib.parse.urlsplit(identifier)
    if parts.scheme != "https" or parts.hostname not in {
        "id.rijksmuseum.nl",
        "data.rijksmuseum.nl",
    }:
        raise ProviderError(f"unexpected Rijksmuseum identifier: {identifier}")
    return urllib.parse.urlunsplit(("https", "data.rijksmuseum.nl", parts.path, "", ""))


def find_nested_values(value: Any, wanted_key: str) -> list[Any]:
    found: list[Any] = []
    if isinstance(value, Mapping):
        for key, nested in value.items():
            if key == wanted_key:
                found.append(nested)
            if isinstance(nested, (Mapping, list, tuple)):
                found.extend(find_nested_values(nested, wanted_key))
    elif isinstance(value, (list, tuple)):
        for nested in value:
            found.extend(find_nested_values(nested, wanted_key))
    return found


def first_mapping(value: Any) -> Mapping[str, Any] | None:
    if isinstance(value, Mapping):
        return value
    if isinstance(value, list):
        return next((entry for entry in value if isinstance(entry, Mapping)), None)
    return None


class RijksmuseumProvider:
    name = "rijksmuseum"
    search_endpoint = "https://data.rijksmuseum.nl/search/collection"
    artwork_types = ("painting", "drawing", "print", "photograph")

    def __init__(self, http: HTTPClientProtocol, rng: random.Random):
        self.http = http
        self.rng = rng

    def _page_url(self, state: Mapping[str, Any], artwork_type: str) -> str:
        provider_state = state.get(self.name)
        if isinstance(provider_state, Mapping):
            type_state = provider_state.get(artwork_type)
            if isinstance(type_state, Mapping):
                saved = clean_text(type_state.get("next"))
                if saved:
                    parts = urllib.parse.urlsplit(saved)
                    if (
                        parts.scheme == "https"
                        and parts.hostname == "data.rijksmuseum.nl"
                        and parts.path == "/search/collection"
                    ):
                        return saved
        return append_query(
            self.search_endpoint,
            {"imageAvailable": "true", "type": artwork_type},
        )

    @staticmethod
    def _object_number(record: Mapping[str, Any]) -> str | None:
        identifiers = record.get("identified_by")
        if not isinstance(identifiers, list):
            return None
        fallback = None
        for identifier in identifiers:
            if not isinstance(identifier, Mapping):
                continue
            content = clean_text(identifier.get("content"))
            if not content:
                continue
            fallback = fallback or content
            classifications = identifier.get("classified_as")
            if isinstance(classifications, list) and any(
                isinstance(entry, Mapping)
                and clean_text(entry.get("id")) == "https://id.rijksmuseum.nl/22015218"
                for entry in classifications
            ):
                return content
        return fallback

    @staticmethod
    def _record_creator(record: Mapping[str, Any]) -> str | None:
        values = find_nested_values(record.get("produced_by"), "carried_out_by")
        labels: list[str] = []
        for value in values:
            entries = value if isinstance(value, list) else [value]
            for entry in entries:
                if not isinstance(entry, Mapping):
                    continue
                notation = entry.get("notation")
                notation_entries = notation if isinstance(notation, list) else []
                english = next(
                    (
                        clean_text(note.get("@value"))
                        for note in notation_entries
                        if isinstance(note, Mapping) and note.get("@language") == "en"
                    ),
                    None,
                )
                fallback = next(
                    (
                        clean_text(note.get("@value"))
                        for note in notation_entries
                        if isinstance(note, Mapping) and clean_text(note.get("@value"))
                    ),
                    None,
                )
                label = english or clean_text(entry.get("_label")) or fallback
                if label and label not in labels:
                    labels.append(label)
        return "; ".join(labels) or None

    @staticmethod
    def _record_title(record: Mapping[str, Any]) -> str | None:
        identifiers = record.get("identified_by")
        choices: list[tuple[int, int, str]] = []
        if isinstance(identifiers, list):
            for identifier in identifiers:
                if (
                    not isinstance(identifier, Mapping)
                    or identifier.get("type") != "Name"
                ):
                    continue
                content = clean_text(identifier.get("content"))
                if not content:
                    continue
                classifications = identifier.get("classified_as")
                classification_ids = (
                    {
                        clean_text(entry.get("id"))
                        for entry in classifications
                        if isinstance(entry, Mapping)
                    }
                    if isinstance(classifications, list)
                    else set()
                )
                if "https://id.rijksmuseum.nl/22015528" in classification_ids:
                    continue
                languages = identifier.get("language")
                is_english = isinstance(languages, list) and any(
                    isinstance(language, Mapping)
                    and clean_text(language.get("id"))
                    == "http://vocab.getty.edu/aat/300388277"
                    for language in languages
                )
                is_brief = "http://vocab.getty.edu/aat/300417207" in classification_ids
                is_current = (
                    "http://vocab.getty.edu/aat/300417200" in classification_ids
                )
                if is_english and is_brief:
                    priority = 0
                elif is_english and is_current:
                    priority = 1
                elif is_brief:
                    priority = 2
                elif is_current:
                    priority = 3
                else:
                    priority = 4
                choices.append((priority, len(content), content))
        if choices:
            return min(choices)[2]
        return clean_text(record.get("_label")) or clean_text(record.get("label"))

    @staticmethod
    def _record_date(record: Mapping[str, Any]) -> str | None:
        for value in find_nested_values(record.get("produced_by"), "timespan"):
            labels = list(iter_text(value))
            if labels:
                return labels[0]
        return None

    def _resolve(self, object_identifier: str, artwork_type: str) -> Artwork:
        object_url = rijks_data_url(object_identifier)
        record = self.http.get_json(object_url, {"_profile": "la-framed"})
        if not isinstance(record, Mapping):
            raise ProviderError("Rijksmuseum object record was not an object")

        visual = first_mapping(record.get("shows"))
        visual_id = clean_text(visual.get("id")) if visual else None
        if not visual_id:
            raise ProviderError("Rijksmuseum object had no visual item")
        visual_record = self.http.get_json(
            rijks_data_url(visual_id), {"_profile": "la-framed"}
        )
        if not isinstance(visual_record, Mapping):
            raise ProviderError("Rijksmuseum visual record was not an object")

        digital = first_mapping(visual_record.get("digitally_shown_by"))
        digital_id = clean_text(digital.get("id")) if digital else None
        if not digital_id:
            raise ProviderError("Rijksmuseum visual item had no digital object")
        digital_record = self.http.get_json(
            rijks_data_url(digital_id), {"_profile": "la-framed"}
        )
        if not isinstance(digital_record, Mapping):
            raise ProviderError("Rijksmuseum digital record was not an object")

        image_id = None
        access_points = digital_record.get("access_point")
        if isinstance(access_points, list):
            for access_point in access_points:
                if not isinstance(access_point, Mapping):
                    continue
                candidate = clean_text(access_point.get("id"))
                if not candidate:
                    continue
                parts = urllib.parse.urlsplit(candidate)
                if parts.scheme == "https" and parts.hostname == "iiif.micr.io":
                    path_parts = [part for part in parts.path.split("/") if part]
                    if path_parts:
                        image_id = path_parts[0]
                        break
        if not image_id:
            raise ProviderError("Rijksmuseum digital object had no Micrio IIIF image")

        object_number = (
            self._object_number(record) or object_url.rstrip("/").split("/")[-1]
        )
        title = self._record_title(record)
        if not title:
            raise ProviderError("Rijksmuseum object had no title")
        return Artwork(
            provider=self.name,
            provider_name="Rijksmuseum",
            record_id=object_number,
            title=title,
            creator=self._record_creator(record),
            date=self._record_date(record),
            attribution="Rijksmuseum, Amsterdam",
            rights="Rijksmuseum open data policy",
            rights_url="https://data.rijksmuseum.nl/",
            source_url=(
                "https://www.rijksmuseum.nl/en/collection/"
                f"{urllib.parse.quote(object_number, safe='')}"
            ),
            image_url=f"https://iiif.micr.io/{image_id}/full/{TARGET_WIDTH},/0/default.webp",
        )

    def select(self, state: Mapping[str, Any]) -> Candidate:
        artwork_type = self.rng.choice(self.artwork_types)
        page = self.http.get_json(self._page_url(state, artwork_type))
        if not isinstance(page, Mapping):
            raise ProviderError("Rijksmuseum search response was not an object")
        items = page.get("orderedItems")
        if not isinstance(items, list) or not items:
            raise ProviderError(f"Rijksmuseum returned no {artwork_type} records")
        items = list(items)
        self.rng.shuffle(items)
        errors: list[str] = []
        for item in items[:20]:
            if not isinstance(item, Mapping):
                continue
            object_identifier = clean_text(item.get("id"))
            if not object_identifier:
                continue
            try:
                artwork = self._resolve(object_identifier, artwork_type)
            except ProviderError as exc:
                errors.append(str(exc))
                continue
            next_block = page.get("next")
            next_url = (
                clean_text(next_block.get("id"))
                if isinstance(next_block, Mapping)
                else None
            )
            return Candidate(
                artwork,
                {self.name: {artwork_type: {"next": next_url}}},
            )
        detail = errors[-1] if errors else "no resolvable record"
        raise ProviderError(f"Rijksmuseum page had no usable {artwork_type}: {detail}")


def merge_state(state: Mapping[str, Any], update: Mapping[str, Any]) -> dict[str, Any]:
    merged: dict[str, Any] = copy.deepcopy(dict(state))

    def merge(target: dict[str, Any], source: Mapping[str, Any]) -> None:
        for key, value in source.items():
            if isinstance(value, Mapping) and isinstance(target.get(key), Mapping):
                nested = dict(target[key])
                merge(nested, value)
                target[key] = nested
            else:
                target[key] = copy.deepcopy(value)

    merge(merged, update)
    merged["version"] = 1
    return merged


def load_state(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {"version": 1}
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        print(f"Warning: ignoring unreadable state file {path}: {exc}", file=sys.stderr)
        return {"version": 1}
    if not isinstance(state, dict):
        print(f"Warning: ignoring invalid state file {path}", file=sys.stderr)
        return {"version": 1}
    return state


def run_command(command: Sequence[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError as exc:
        raise WallpaperError(f"required command not found: {command[0]}") from exc
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or str(exc)).strip()
        raise WallpaperError(f"command failed ({' '.join(command)}): {detail}") from exc


def image_dimensions(source: Path) -> tuple[int, int]:
    result = run_command(["magick", "identify", "-format", "%w %h", str(source)])
    try:
        width, height = (int(part) for part in result.stdout.strip().split())
    except (TypeError, ValueError) as exc:
        raise WallpaperError("ImageMagick returned invalid image dimensions") from exc
    if width < 1 or height < 1:
        raise WallpaperError("image has invalid dimensions")
    return width, height


def masp_image_is_large_enough(width: int, height: int) -> bool:
    return (
        max(width, height) >= MASP_MIN_LONG_EDGE
        and min(width, height) >= MASP_MIN_SHORT_EDGE
    )


def process_image(source: Path, destination: Path) -> tuple[int, int]:
    run_command(
        [
            "magick",
            str(source),
            "-auto-orient",
            "-resize",
            f"{TARGET_WIDTH}x>",
            "-strip",
            "-quality",
            "90",
            str(destination),
        ]
    )
    return image_dimensions(destination)


def render_greeter_image(source: Path, destination: Path) -> tuple[int, int]:
    """Render the current wallpaper in Qt's built-in PNG format for SDDM."""
    run_command(
        [
            "magick",
            str(source),
            "-strip",
            "-define",
            "png:compression-level=9",
            f"PNG:{destination}",
        ]
    )
    return image_dimensions(destination)


def publish_greeter_image(data_dir: Path) -> tuple[int, int]:
    source = data_dir / "current.webp"
    if not source.is_file():
        raise WallpaperError(f"no current wallpaper image found at {source}")

    descriptor, name = tempfile.mkstemp(
        prefix=".current-",
        suffix=".png",
        dir=data_dir,
    )
    os.close(descriptor)
    temporary = Path(name)
    try:
        dimensions = render_greeter_image(source, temporary)
        temporary.chmod(0o640)
        with temporary.open("rb") as image:
            os.fsync(image.fileno())
        os.replace(temporary, data_dir / "current.png")
        return dimensions
    finally:
        temporary.unlink(missing_ok=True)


def write_json_temp(directory: Path, prefix: str, value: Mapping[str, Any]) -> Path:
    descriptor, name = tempfile.mkstemp(prefix=prefix, suffix=".json", dir=directory)
    path = Path(name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, ensure_ascii=False, indent=2, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        path.chmod(0o640)
        return path
    except Exception:
        path.unlink(missing_ok=True)
        raise


def publish(
    data_dir: Path,
    image: Path,
    greeter_image: Path,
    metadata: Mapping[str, Any],
    state: Mapping[str, Any],
) -> None:
    metadata_temp = write_json_temp(data_dir, ".current-", metadata)
    state_temp = write_json_temp(data_dir, ".state-", state)
    image.chmod(0o640)
    greeter_image.chmod(0o640)
    try:
        os.replace(image, data_dir / "current.webp")
        os.replace(greeter_image, data_dir / "current.png")
        os.replace(metadata_temp, data_dir / "current.json")
        os.replace(state_temp, data_dir / "state.json")
    finally:
        metadata_temp.unlink(missing_ok=True)
        state_temp.unlink(missing_ok=True)


T = TypeVar("T")


def first_success(names: Sequence[str], attempt: Callable[[str], T]) -> T:
    errors: dict[str, str] = {}
    for name in names:
        try:
            return attempt(name)
        except (WallpaperError, OSError, ValueError, KeyError) as exc:
            errors[name] = str(exc)
            print(f"Provider {name} failed: {exc}", file=sys.stderr)
    raise AllProvidersError(errors)


@dataclasses.dataclass
class StagedArtwork:
    candidate: Candidate
    image: Path
    greeter_image: Path
    width: int
    height: int
    temporary_directory: Path


def stage_provider(
    name: str,
    providers: Mapping[str, Any],
    state: Mapping[str, Any],
    http: HTTPClientProtocol,
    data_dir: Path,
) -> StagedArtwork:
    temporary_directory = Path(tempfile.mkdtemp(prefix=f".{name}-", dir=data_dir))
    try:
        candidate = providers[name].select(state)
        source = temporary_directory / "download"
        processed = temporary_directory / "wallpaper.webp"
        greeter_image = temporary_directory / "greeter.png"
        http.download(candidate.artwork.image_url, source)
        if candidate.artwork.provider == "masp":
            width, height = image_dimensions(source)
            if not masp_image_is_large_enough(width, height):
                raise ProviderError(
                    "MASP image is below the 2560x1440 wallpaper source floor "
                    f"({width}x{height})"
                )
        width, height = process_image(source, processed)
        greeter_dimensions = render_greeter_image(processed, greeter_image)
        if greeter_dimensions != (width, height):
            raise WallpaperError(
                "SDDM greeter image dimensions differ from the wallpaper "
                f"({greeter_dimensions[0]}x{greeter_dimensions[1]} != "
                f"{width}x{height})"
            )
        return StagedArtwork(
            candidate,
            processed,
            greeter_image,
            width,
            height,
            temporary_directory,
        )
    except Exception:
        shutil.rmtree(temporary_directory, ignore_errors=True)
        raise


def provider_order(requested: str, rng: random.Random) -> list[str]:
    if requested != "auto":
        return [requested]
    names = list(PROVIDER_NAMES)
    rng.shuffle(names)
    return names


def default_data_dir() -> Path:
    override = os.environ.get("ARTS_WALLPAPER_DATA_DIR")
    return Path(override).expanduser() if override else Path("/var/lib/arts-wallpaper")


def load_current_metadata(path: Path) -> dict[str, Any]:
    try:
        metadata = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise WallpaperError(f"no current wallpaper metadata found at {path}") from exc
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise WallpaperError(
            f"could not read current wallpaper metadata at {path}: {exc}"
        ) from exc

    if not isinstance(metadata, dict):
        raise WallpaperError(
            f"invalid current wallpaper metadata at {path}: expected an object"
        )

    required_strings = (
        "provider",
        "provider_name",
        "record_id",
        "title",
        "attribution",
        "source_url",
        "image_url",
        "downloaded",
    )
    for key in required_strings:
        value = metadata.get(key)
        if not isinstance(value, str) or not value.strip():
            raise WallpaperError(
                f"invalid current wallpaper metadata at {path}: "
                f"{key!r} must be a non-empty string"
            )

    for key in ("width", "height"):
        value = metadata.get(key)
        if not isinstance(value, int) or isinstance(value, bool) or value < 1:
            raise WallpaperError(
                f"invalid current wallpaper metadata at {path}: "
                f"{key!r} must be a positive integer"
            )

    return metadata


def format_current_metadata(metadata: Mapping[str, Any], wallpaper_path: Path) -> str:
    fields: list[tuple[str, str]] = []

    def add(label: str, value: Any) -> None:
        if isinstance(value, str) and value.strip():
            fields.append((label, value.strip()))

    add("Title", metadata["title"])
    add("Artist", metadata.get("creator"))
    add("Date", metadata.get("date"))
    add("Provider", metadata["provider_name"])
    add("Credit", metadata["attribution"])
    add("Rights", metadata.get("rights"))
    add("Rights URL", metadata.get("rights_url"))
    fields.append(("Dimensions", f"{metadata['width']}x{metadata['height']}"))
    add("Downloaded", metadata["downloaded"])
    add("Source", metadata["source_url"])
    fields.append(("Wallpaper", str(wallpaper_path)))
    return "\n".join(f"{label}: {value}" for label, value in fields)


def show_current(data_dir: Path, as_json: bool) -> int:
    metadata = load_current_metadata(data_dir / "current.json")
    if as_json:
        print(json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(format_current_metadata(metadata, data_dir / "current.webp"))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--json",
        action="store_true",
        help="print the current wallpaper's complete metadata as JSON",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    subparsers = parser.add_subparsers(dest="command", metavar="COMMAND")
    rotate_parser = subparsers.add_parser(
        "rotate",
        help="fetch and publish a new artwork wallpaper",
        description="Fetch an artwork and publish it as the current Hyprpaper image.",
    )
    rotate_parser.add_argument(
        "--provider",
        choices=("auto",) + PROVIDER_NAMES,
        default="auto",
        help="force one provider; auto randomly orders all providers (default: auto)",
    )
    rotate_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="fetch and validate without publishing, changing state, or restarting Hyprpaper",
    )
    rotate_parser.add_argument(
        "--no-restart",
        action="store_true",
        help="publish the wallpaper without restarting hyprpaper.service",
    )
    subparsers.add_parser(
        "render-greeter",
        help="render current.png for the SDDM greeter",
        description=(
            "Atomically render an SDDM-compatible PNG from the current WebP wallpaper."
        ),
    )
    return parser


def render_greeter_wallpaper(data_dir: Path) -> int:
    data_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
    lock_path = data_dir / ".lock"

    with lock_path.open("a", encoding="utf-8") as lock:
        os.fchmod(lock.fileno(), 0o640)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another arts-wallpaper update is already running", file=sys.stderr)
            return 1

        try:
            width, height = publish_greeter_image(data_dir)
        except (WallpaperError, OSError) as exc:
            print(f"SDDM greeter image render failed: {exc}", file=sys.stderr)
            return 1

        print(f"Rendered SDDM greeter image: {width}x{height}")
        return 0


def rotate_wallpaper(args: argparse.Namespace, data_dir: Path) -> int:
    data_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
    lock_path = data_dir / ".lock"

    with lock_path.open("a", encoding="utf-8") as lock:
        os.fchmod(lock.fileno(), 0o640)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another arts-wallpaper update is already running", file=sys.stderr)
            return 1

        rng = random.SystemRandom()
        state_path = data_dir / "state.json"
        state = load_state(state_path)
        http = HTTPClient()
        providers = {
            "google": GoogleProvider(http, rng),
            "rijksmuseum": RijksmuseumProvider(http, rng),
            "cleveland": ClevelandProvider(http, rng),
            "masp": MaspProvider(http, rng),
            "mnw": MnwProvider(http, rng),
        }
        order = provider_order(args.provider, rng)
        print(f"Provider order: {', '.join(order)}")

        staged: StagedArtwork | None = None
        try:
            staged = first_success(
                order,
                lambda name: stage_provider(name, providers, state, http, data_dir),
            )
            metadata = staged.candidate.artwork.metadata(staged.width, staged.height)
            if args.dry_run:
                print(
                    json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True)
                )
                return 0

            updated_state = merge_state(state, staged.candidate.state_update)
            publish(
                data_dir,
                staged.image,
                staged.greeter_image,
                metadata,
                updated_state,
            )
            artwork = staged.candidate.artwork
            print(f"Published: {artwork.title} — {artwork.creator or 'Unknown artist'}")
            print(f"Provider: {artwork.provider_name}")
            print(f"Source: {artwork.source_url}")
        except WallpaperError as exc:
            print(f"Wallpaper update failed: {exc}", file=sys.stderr)
            return 1
        finally:
            if staged is not None:
                shutil.rmtree(staged.temporary_directory, ignore_errors=True)

        if not args.no_restart:
            try:
                run_command(["systemctl", "--user", "restart", "hyprpaper.service"])
            except WallpaperError as exc:
                print(
                    f"Wallpaper published but Hyprpaper restart failed: {exc}",
                    file=sys.stderr,
                )
                return 1
            print("Hyprpaper restarted successfully")
        return 0


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    data_dir = default_data_dir()

    if args.command == "rotate":
        if args.json:
            parser.error("--json cannot be used with rotate")
        return rotate_wallpaper(args, data_dir)

    if args.command == "render-greeter":
        if args.json:
            parser.error("--json cannot be used with render-greeter")
        return render_greeter_wallpaper(data_dir)

    try:
        return show_current(data_dir, args.json)
    except WallpaperError as exc:
        print(f"Current wallpaper lookup failed: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
