#!/usr/bin/env python3
"""Print the Hermes Email gateway password for local mail clients."""

from pathlib import Path
import shlex
import sys

ENV_PATH = Path.home() / ".hermes" / ".env"
KEY = "EMAIL_PASSWORD"

try:
    lines = ENV_PATH.read_text(encoding="utf-8").splitlines()
except OSError as exc:
    print(f"cannot read {ENV_PATH}: {exc}", file=sys.stderr)
    raise SystemExit(1)

for raw in lines:
    stripped = raw.strip()
    if not stripped or stripped.startswith("#") or "=" not in stripped:
        continue
    key, value = stripped.split("=", 1)
    if key.strip() != KEY:
        continue
    try:
        parsed = shlex.split(value.strip(), comments=True, posix=True)
    except ValueError as exc:
        print(f"cannot parse {KEY} in {ENV_PATH}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    if len(parsed) != 1 or not parsed[0]:
        print(f"{KEY} is empty or malformed in {ENV_PATH}", file=sys.stderr)
        raise SystemExit(1)
    print(parsed[0])
    raise SystemExit(0)

print(f"{KEY} is not set in {ENV_PATH}", file=sys.stderr)
raise SystemExit(1)
