{{- if eq .chezmoi.os "darwin" }}
Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519

{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{- if eq .chezmoi.hostname "rivest" }}
Host *
  IdentityAgent ~/.1password/agent.sock

{{- end }}
Host github.com
  IdentityFile ~/.ssh/vitorpy
  IdentitiesOnly yes
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts2 ~/.ssh/known_hosts.d/github

Host aur.archlinux.org
  IdentityFile ~/.ssh/aur
  User aur

{{- end }}

Host mediaserver
  HostName 192.168.1.94
  User vitorpy

Host scherbius.vitorpy.com
  User vitorpy
  ForwardAgent yes
  SendEnv GROK_API_KEY
  SendEnv OPENROUTER_API_KEY

Host rejewski.vitorpy.com
  User vitorpy
  ForwardAgent yes
  SendEnv GROK_API_KEY
  SendEnv OPENROUTER_API_KEY
